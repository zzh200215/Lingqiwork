# Python
__pycache__/
.venv/
*.pyc

# Data (local-first, personal)
data/
backups/
vault/

# Runtime logs & temp
*.log
wb-*/
.smoke*/
.playwright-mcp/
# 一次性的验证脚本与截图（每轮的 scratch；留作证据，但不进版本库）
.tmp-*/

# Node handled by frontend/.gitignore

# Tool / agent data
.workbuddy/
.claude/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# TS build cache
*.tsbuildinfo

# damaged git history kept as backup (not tracked)
.git.corrupt*/
.zcode/

# 一次性探针残留（_p1.txt / _p2.txt …）
_p*.txt

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
