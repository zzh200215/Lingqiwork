# Python
__pycache__/
.venv/
*.pyc

# Data (local-first, personal)
data/
backups/
vault/

# Runtime logs & temp
*.log
wb-*/
.smoke*/
.playwright-mcp/
# 一次性的验证脚本与截图（每轮的 scratch；留作证据，但不进版本库）
.tmp-*/

# Node handled by frontend/.gitignore——根目录不装依赖；在根误跑 npx 会留下
# node_modules/，加一行兜底，别让流浪目录挂在 git status 里。
node_modules/

# Tool / agent data
.workbuddy/
.claude/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# TS build cache
*.tsbuildinfo

# damaged git history kept as backup (not tracked)
.git.corrupt*/
.zcode/

# 一次性探针残留（_p1.txt / _p2.txt …）
_p*.txt

# 皮肤预览（`frontend/scripts/preview-themes.mjs` 生成，随时可再生成一遍）
theme-preview.html
# Windows 文件权限修复留下的备份与回滚脚本（诊断工具写的，不属于仓库）
.acl-recovery/
# 受限沙箱下跑前端测试的备用配置（工具，不是产品代码；用法见文件开头）
frontend/vitest.sandbox.config.mjs
